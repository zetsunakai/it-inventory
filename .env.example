# Salin ke .env.local lalu sesuaikan bila perlu.
# Nilai default cocok dengan docker-compose.yml.
DATABASE_URL=postgres://it_inventory:it_inventory@localhost:5433/it_inventory

# Better Auth. Buat secret dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-secret-acak
BETTER_AUTH_URL=http://localhost:3000

# Akun Administrator awal yang dibuat oleh `npm run db:seed`.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@it-inventory.local
SEED_ADMIN_PASSWORD=ganti-password-ini

# Opsional, hanya untuk lokal: satu akun demo per peran (manajer, exim, gudang, auditor).
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=ganti-password-demo
# Opsional, hanya untuk lokal: contoh alur dokumen BC (BC 2.3 Terdaftar, penerimaan lewat gerbang,
# BC 2.5 dengan alokasi asal). Butuh profil perusahaan sudah diisi.
SEED_DEMO_DATA=false

# Penyimpanan file (lampiran dokumen BC). local = folder STORAGE_DIR; s3 = object storage
# S3-compatible (AWS S3, MinIO, R2), alamat path-style <S3_ENDPOINT>/<S3_BUCKET>/<kunci>.
STORAGE_DRIVER=local
STORAGE_DIR=.storage
# S3_ENDPOINT=https://s3.ap-southeast-3.amazonaws.com
# S3_REGION=ap-southeast-3
# S3_BUCKET=it-inventory
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
